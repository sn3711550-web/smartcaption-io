rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'plan', 'freeCreditsUsed', 'freeCreditsMax', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'plan', 'freeCreditsUsed', 'freeCreditsMax', 'totalExportsCount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.plan in ['free', 'pro', 'business']
        && data.freeCreditsUsed is number && data.freeCreditsUsed >= 0
        && data.freeCreditsMax is number && data.freeCreditsMax >= 0
        && (!('totalExportsCount' in data) || (data.totalExportsCount is number && data.totalExportsCount >= 0));
    }

    function isValidUserProject(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'language', 'styleId', 'aspectRatio', 'duration', 'segmentsCount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && (!('language' in data) || (data.language is string && data.language.size() <= 50))
        && (!('styleId' in data) || (data.styleId is string && data.styleId.size() <= 64))
        && (!('aspectRatio' in data) || data.aspectRatio in ['9:16', '1:1', '16:9', '4:5'])
        && (!('duration' in data) || (data.duration is number && data.duration >= 0))
        && (!('segmentsCount' in data) || (data.segmentsCount is number && data.segmentsCount >= 0));
    }

    // Users collection: persistent account data and usage limits
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user listing forbidden

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().id == userId
        && incoming().id == request.auth.uid;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'freeCreditsUsed',
          'totalExportsCount',
          'updatedAt',
          'displayName',
          'photoURL',
          'plan'
        ]);

      allow delete: if false;

      // Subcollection for user's saved caption projects
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(projectId)
          && isValidUserProject(incoming())
          && incoming().id == projectId
          && incoming().userId == userId;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(projectId)
          && isValidUserProject(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'language',
            'styleId',
            'aspectRatio',
            'duration',
            'segmentsCount',
            'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
      }
    }
  }
}
